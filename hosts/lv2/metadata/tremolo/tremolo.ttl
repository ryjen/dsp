@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
<https://micrantha.com/lv2/tremolo>
    a lv2:Plugin ;
    doap:name "Micrantha Tremolo" ;
    doap:license <https://opensource.org/license/mit/> ;
    lv2:requiredFeature lv2:inPlaceBroken ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ] ,
        [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ] ,
        [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ] ,
        [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "rate_hz" ; lv2:name "Rate (Hz)" ; lv2:default 4 ; lv2:minimum 0.1 ; lv2:maximum 20 ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "depth" ; lv2:name "Depth" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] .
