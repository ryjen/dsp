@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<https://micrantha.com/lv2/delay>
    a lv2:Plugin ;
    doap:name "Micrantha Delay" ;
    doap:license <https://opensource.org/license/mit/> ;
    lv2:requiredFeature lv2:inPlaceBroken ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ] ,
        [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ] ,
        [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ] ,
        [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "time_ms" ; lv2:name "Free delay (ms)" ; lv2:default 250 ; lv2:minimum 1 ; lv2:maximum 2000 ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 0.95 ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "mix" ; lv2:name "Wet mix" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "tempo_bpm" ; lv2:name "BPM" ; lv2:default 120 ; lv2:minimum 20 ; lv2:maximum 300 ] ,
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "subdivision" ; lv2:name "Subdivision" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ; lv2:portProperty lv2:integer, lv2:enumeration ;
          lv2:scalePoint [ rdfs:label "Free" ; rdf:value 0 ] ;
          lv2:scalePoint [ rdfs:label "Quarter" ; rdf:value 1 ] ;
          lv2:scalePoint [ rdfs:label "Dotted eighth" ; rdf:value 2 ] ;
          lv2:scalePoint [ rdfs:label "Eighth" ; rdf:value 3 ] ;
          lv2:scalePoint [ rdfs:label "Eighth triplet" ; rdf:value 4 ] ;
          lv2:scalePoint [ rdfs:label "Sixteenth" ; rdf:value 5 ] ] .
